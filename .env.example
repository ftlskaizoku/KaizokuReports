# Kaizoku Reports environment variables

# PostgreSQL connection string for Neon or other hosted Postgres (optional if using Firebase)
DATABASE_URL=postgresql://username:password@host:port/dbname?sslmode=require

# Firebase configuration (required if using Firebase)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# JWT secret used to sign auth tokens
JWT_SECRET=your-long-random-secret

# Google OAuth client ID for browser sign-in
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Secret for cron endpoint protection
CRON_SECRET=another-random-secret

# Optional: push notifications VAPID keys
VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_EMAIL=mailto:your@email.com
