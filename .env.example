# Database — Railway provides this automatically as DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — generate a long random string
JWT_SECRET=your-very-long-random-secret-here-change-this

# EA Authentication — the EA sends this key in every request
EA_API_KEY=your-ea-api-key-change-this

# Web Push VAPID keys — generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your@email.com

# App
PORT=3000
NODE_ENV=production
APP_URL=https://your-app.railway.app
