# Kaizoku Reports environment variables

# PostgreSQL connection string for Neon or other hosted Postgres
DATABASE_URL=postgresql://username:password@host:port/dbname?sslmode=require

# JWT secret used to sign auth tokens
JWT_SECRET=your-long-random-secret

# Google OAuth client ID for browser sign-in
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Secret for cron endpoint protection
CRON_SECRET=another-random-secret

# Optional: push notifications VAPID keys
VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_EMAIL=mailto:your@email.com
